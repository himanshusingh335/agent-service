OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
# Optional: sampling temperature (float). Leave unset to use the model's default.
OPENROUTER_TEMPERATURE=0
# Optional: reasoning effort for reasoning-capable models (none|minimal|low|medium|high|xhigh).
# Leave unset to disable the reasoning param entirely. Note: on most reasoning models,
# setting this overrides/ignores OPENROUTER_TEMPERATURE.
OPENROUTER_REASONING_EFFORT=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_service

HOST=0.0.0.0
PORT=8000
RELOAD=false

SUMMARIZATION_KEEP_MESSAGES=20
